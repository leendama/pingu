{
  "name": "pingu",
  "version": "0.1.0",
  "description": "A self-hosted iMessage assistant with Google Calendar, Gmail, Granola, reminders, and extensible Spectrum actions.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "connect:google": "tsx src/connect-google.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "googleapis": "^176.0.0",
    "helmet": "^8.1.0",
    "openai": "^7.5.0",
    "spectrum-ts": "^12.8.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
