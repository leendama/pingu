{
  "name": "pingu",
  "version": "0.1.0",
  "description": "A self-hosted iMessage assistant with Google Calendar, Gmail, Granola, reminders, and extensible Spectrum actions.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "connect:google": "tsx src/connect-google.ts",
    "doctor": "tsx src/doctor.ts",
    "claim": "tsx src/claim-code.ts",
    "reset-data": "tsx src/reset-data.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "eval:priorities": "tsx src/eval-priorities.ts",
    "eval:commitments": "tsx src/eval-commitments.ts",
    "eval:meetings": "tsx src/eval-meeting-outcomes.ts",
    "eval:quality": "tsx src/eval-quality.ts",
    "test:browser": "PINGU_BROWSER_E2E=1 vitest run src/browser-port.test.ts"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "googleapis": "^176.0.0",
    "helmet": "^8.1.0",
    "openai": "^7.5.0",
    "playwright": "^1.63.0",
    "spectrum-ts": "^12.8.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
