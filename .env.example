# ============================================================
# Local setup (.env on your Mac) — see docs/SETUP.md "Run it on your Mac"
# ============================================================

# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna.
OPENAI_MODEL=
# Optional personalisation.
OWNER_NAME=
ASSISTANT_NAME=
ASSISTANT_TIMEZONE=UTC
# Optional paths for keeping private runtime files outside this checkout.
GOOGLE_CREDENTIALS_PATH=
PINGU_PLUGIN_DIR=
# Optional. Required only for Granola note access.
GRANOLA_API_KEY=
# Optional. Direct Google OAuth values as an alternative to `npm run connect:google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=

# ============================================================
# Shared by both modes
# ============================================================

# Folder for settings, reminders, conversations, and the encrypted config.
# Defaults to ./data. Optional locally; REQUIRED for hosted deployments —
# point it at a persistent disk, or a redeploy wipes your configuration.
PHOTON_DATA_DIR=

# ============================================================
# Hosted wizard mode (Docker or an always-on host) — see docs/SETUP.md
# "Use the browser setup wizard". Setting PHOTON_SETUP_TOKEN switches
# Pingu into wizard mode; credentials are then entered in the browser
# and encrypted on disk, so the credential variables in the local
# section are not needed. PHOTON_DATA_DIR above still is.
# ============================================================

# Random secret of at least 20 characters. Unlocks the /setup page.
PHOTON_SETUP_TOKEN=
# Different random secret of at least 24 characters. Encrypts saved settings.
PHOTON_CONFIG_KEY=
# Public HTTPS address of your host, used for the Google OAuth redirect.
PHOTON_PUBLIC_URL=
# Wizard port. Defaults to 3000.
PORT=
