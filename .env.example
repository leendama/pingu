# ============================================================
# Local setup (.env on your Mac) — see docs/SETUP.md "Run it on your Mac"
# ============================================================

# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna.
OPENAI_MODEL=
# Optional. An OpenAI Responses-compatible endpoint that supports function
# calling, such as Ollama (http://localhost:11434/v1) or LM Studio
# (http://localhost:1234/v1). Leave blank for OpenAI. Voice replies need OpenAI.
# Inside Docker, localhost is the container; a model on your Mac is
# http://host.docker.internal:11434/v1.
OPENAI_BASE_URL=
# Optional personalisation.
OWNER_NAME=
ASSISTANT_NAME=
ASSISTANT_TIMEZONE=UTC
# Optional paths for keeping private runtime files outside this checkout.
GOOGLE_CREDENTIALS_PATH=
PINGU_PLUGIN_DIR=
# Optional. Required only for Granola note access.
GRANOLA_API_KEY=
# Google. Releases ship Pingu's own Google app, so `npm run connect:google`
# needs no credentials.json: you only click through Google's consent screen.
# Provide your own OAuth client (credentials.json or GOOGLE_CREDENTIALS_PATH)
# to use your own Google Cloud project instead.
# Optional. Direct Google OAuth values as an alternative to `npm run connect:google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=

# ============================================================
# Owner, guests, and bookings (both modes)
# ============================================================

# Who owns this assistant is proven by texting a claim code (`npm run claim`
# or the setup page), never by typing a phone number. This optional list adds
# sender ids you already know from Spectrum, comma separated.
PINGU_OWNER_SENDER_IDS=
# Guest caps. Anyone can text the number; these protect the model bill.
PINGU_GUEST_DAILY_MESSAGE_CAP=20
PINGU_GUEST_DAILY_TOKEN_BUDGET=300000
PINGU_GUEST_MAX_REMINDERS=5
# Longest guest text Pingu will read, tokens reserved per guest turn against
# the daily budget, and tool rounds a guest turn may take.
PINGU_GUEST_MAX_INBOUND_CHARS=2000
PINGU_GUEST_MAX_TURN_TOKENS=20000
PINGU_GUEST_MAX_TOOL_ROUNDS=4
PINGU_GUEST_MAX_OUTPUT_TOKENS=1500
# When guests may book you, in ASSISTANT_TIMEZONE. "09:00-17:00" or "24h".
PINGU_BOOKABLE_HOURS=09:00-17:00
# "weekdays", "all", or day numbers 0-6 (Sunday = 0) separated by commas.
PINGU_BOOKABLE_DAYS=weekdays
PINGU_DEFAULT_MEETING_MINUTES=30
# Add a Google Meet link to bookings guests make.
PINGU_MEET_LINK=true

# ============================================================
# Privacy (both modes)
# ============================================================

# Chat history stays on this machine. Entries older than this are dropped.
PINGU_TRANSCRIPT_RETENTION_DAYS=30
# Spectrum SDK telemetry is off unless you opt in.
PINGU_TELEMETRY=false

# ============================================================
# Shared by both modes
# ============================================================

# Folder for settings, reminders, transcripts, and the encrypted config.
# Defaults to ./data. Optional locally; REQUIRED for hosted deployments —
# point it at a persistent disk, or a redeploy wipes your configuration.
PHOTON_DATA_DIR=

# ============================================================
# Hosted wizard mode (Docker or an always-on host) — see docs/SETUP.md
# "Use the browser setup wizard". Setting PHOTON_SETUP_TOKEN switches
# Pingu into wizard mode; credentials are then entered in the browser
# and encrypted on disk, so the credential variables in the local
# section are not needed. PHOTON_DATA_DIR above still is.
# ============================================================

# Random secret of at least 20 characters. Unlocks the /setup page.
PHOTON_SETUP_TOKEN=
# Different random secret of at least 24 characters. Encrypts saved settings.
PHOTON_CONFIG_KEY=
# Public HTTPS address of your host, used for the Google OAuth redirect.
PHOTON_PUBLIC_URL=
# Wizard port. Defaults to 3000.
PORT=
